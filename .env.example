# ============================================================
#  FILE MẪU - đừng sửa file này.
#  Muốn chạy ở MÁY TÍNH: copy thành file tên ".env" rồi điền giá trị thật.
#  Khi deploy lên Render: điền thẳng vào mục Environment  (không cần file .env)
# ============================================================

# Lấy từ: developers.facebook.com -> App của bạn -> Settings -> Basic
# App ID là dãy số, App Secret là chuỗi chữ-số dài
APP_ID=1234567890123456
APP_SECRET=***

# Chạy ở máy tính:  http://localhost:3000/auth/callback
# Chạy trên Render: https://TEN-APP.onrender.com/auth/callback
REDIRECT_URI=http://localhost:3000/auth/callback

# Chuỗi bí mật tự nghĩ, càng dài càng tốt (dùng ký mã phiên đăng nhập web)
SESSION_SECRET=day-la-chuoi-bi-mat-dai-ngau-nhien-khong-cho

# (BẮT BUỘC) Khóa mã hóa token Facebook (AES-256-GCM) — chuỗi ngẫu nhiên tối thiểu 16 ký tự.
# KHÔNG trùng SESSION_SECRET. Sinh nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=thay-bang-chuoi-ngau-nhien-dai-toi-thieu-16-ky-tu

# (Tùy chọn) Phiên bản Graph API. Mặc định v25.0. Chỉ sửa khi Facebook báo lỗi version.
# GRAPH_VERSION=v25.0
